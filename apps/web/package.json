{
  "name": "@cf-one/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir ../../dist",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cf-one --local",
    "db:migrate:remote": "wrangler d1 migrations apply cf-one --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}
